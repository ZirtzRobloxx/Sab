local function dapatkanUIElemen()
    for _, gui in pairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "AutoRedeemMobileUI" then
            local codesFrame = gui:FindFirstChild("Codes", true)
            if codesFrame then
                local codeRedeemObj = codesFrame:FindFirstChild("CodeRedeem")
                local confirmBtn = codesFrame:FindFirstChild("Confirm")
                
                local realTextBox = nil
                if codeRedeemObj then
                    if codeRedeemObj:IsA("TextBox") then
                        realTextBox = codeRedeemObj
                    else
                        realTextBox = codeRedeemObj:FindFirstChildOfClass("TextBox", true)
                    end
                end
                
                if realTextBox and confirmBtn then
                    return realTextBox, confirmBtn
                end
            end
        end
    end

    for _, gui in pairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "AutoRedeemMobileUI" then
            for _, descendant in pairs(gui:GetDescendants()) do
                if descendant:IsA("TextBox") and (descendant.PlaceholderText == "Code Here..." or string.find(string.lower(descendant.PlaceholderText), "code")) then
                    local parent = descendant.Parent
                    local confirmBtn = parent and parent:FindFirstChild("Confirm")
                    return descendant, confirmBtn
                end
            end
        end
    end

    return nil, nil
end

local function tekanTombolConfirm(confirmBtn)
    if not confirmBtn then return end
    
    if firesignal then
        pcall(function() firesignal(confirmBtn.MouseButton1Click) end)
        pcall(function() firesignal(confirmBtn.Activated) end)
    end

    if getconnections then
        for _, connection in pairs(getconnections(confirmBtn.MouseButton1Click)) do
            pcall(function() connection:Fire() end)
        end
        for _, connection in pairs(getconnections(confirmBtn.Activated)) do
            pcall(function() connection:Fire() end)
        end
    end
    
    pcall(function()
        confirmBtn.InputBegan:Fire({
            UserInputType = Enum.UserInputType.MouseButton1,
            UserInputState = Enum.UserInputState.Begin
        })
    end)
end

local function isBlacklisted(text)
    local lowerText = string.lower(text)
    
    if string.find(lowerText, "sfx") or string.find(lowerText, "top") or string.find(lowerText, "bottom") then
        return true
    end

    if string.find(lowerText, "returning%d+") then
        return true
    end

    local blacklist = {
        "starting", "in:", "live", "now", "event", "start", "play", "claim", 
        "code", "redeem", "health", "mana", "level", "lvl", "submit", 
        "friend boost", "codes", "global", "transparency", "namelabel", 
        "stroke", "expired", "invalid", "success", "here", "purchase", 
        "buy", "price", "robux", "cost", "explosion", "boom",
        "ground", "idsteals", "back", "returning", "generation", "id", 
        "steals", "generationidsteals", "money"
    }

    for _, word in ipairs(blacklist) do
        if string.find(lowerText, word) then 
            return true 
        end
    end
    return false
end

local function hookRemote(obj)
    if obj:IsA("RemoteEvent") then
        obj.OnClientEvent:Connect(function(...)
            if not _G.AutoRedeem then return end
            
            local args = {...}
            for _, arg in ipairs(args) do
                if type(arg) == "string" and #arg > 0 and #arg <= 30 and not isBlacklisted(arg) then
                    table.insert(antreanTeks, arg)
                    
                    local kodeLengkap = table.concat(antreanTeks, "")
                    local targetTextBox, targetConfirmBtn = dapatkanUIElemen()
                    
                    if targetTextBox then
                        targetTextBox.Text = kodeLengkap
                        
                        if #antreanTeks < 3 then
                            StatusLabel.Text = "Menunggu... (" .. #antreanTeks .. "/3): " .. kodeLengkap
                        else
                            StatusLabel.Text = "Submitted (" .. #antreanTeks .. " Pcs): " .. kodeLengkap
                            tekanTombolConfirm(targetConfirmBtn)
                        end
                    end
                end
            end
        end)
    end
end

