local KEY_DATABASE_URL = "https://gist.githubusercontent.com/ZirtzRobloxx/d2e708b9d9cdc17a5026fe5cdf7f1c31/raw/0162c78831196dbe742e1d8ee26782c416787a92/IDK.json" 

local function parseDateTime(str)
    local y, m, d, h, min, s = str:match("(%d+)-(%d+)-(%d+) (%d+):(%d+):(%d+)")
    if y then
        return os.time({
            year = tonumber(y),
            month = tonumber(m),
            day = tonumber(d),
            hour = tonumber(h),
            min = tonumber(min),
            sec = tonumber(s)
        })
    end
    return 0
end

local function validateKey(userKey)
    userKey = userKey:gsub("%s+", "")

    local success, response = pcall(function()
        return game:HttpGet(KEY_DATABASE_URL)
    end)

    if not success or not response then
        return false, "Gagal terhubung ke Database Key!"
    end

    local keyData
    local jsonSuccess = pcall(function()
        keyData = HttpService:JSONDecode(response)
    end)

    if not jsonSuccess or not keyData then
        return false, "Format Database Key Salah!"
    end

    local expirationStr = keyData[userKey]

    if not expirationStr then
        return false, "Key tidak ditemukan / Salah!"
    end

    local expireTime = parseDateTime(expirationStr)
    local currentTime = os.time()

    if currentTime > expireTime then
        return false, "Key sudah kadaluwarsa (Expired)!"
    end

    local sisaDetik = expireTime - currentTime
    local sisaHari = math.floor(sisaDetik / 86400)
    local sisaJam = math.floor((sisaDetik % 86400) / 3600)

    return true, string.format("Key Aktif! Sisa: %d Hari %d Jam", sisaHari, sisaJam)
end

