local antiLagActive = false
local originalParticleRates = {}
local descendantConnection = nil

local function applyOptimization(v)
    if v:IsA("ParticleEmitter") then
        if not originalParticleRates[v] then originalParticleRates[v] = v.Rate end
        v.Rate = math.max(0.1, originalParticleRates[v] * 0.005)
    elseif v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") then
        v.Enabled = false
    elseif v:IsA("Decal") or v:IsA("Texture") then
        v.Transparency = 1
    elseif v:IsA("BasePart") then
        v.Material = Enum.Material.Plastic
        v.Reflectance = 0
        v.CastShadow = false
    end
end

