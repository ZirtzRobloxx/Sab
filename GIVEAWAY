    end
end

local function solveRiddleWithAI(riddleText)
    StatusLabel.Text = "AI Solving Riddle..."
    local prompt = "Answer this riddle or brainrot question with ONLY the direct answer word or phrase, no extra punctuation: " .. riddleText
    local encodedPrompt = HttpService:UrlEncode(prompt)
    local fallbackUrl = "https://text.pollinations.ai/" .. encodedPrompt

    local success, response = pcall(function()
        return game:HttpGet(fallbackUrl)
    end)

    if success and response then
        local cleanAnswer = response:gsub("\n", ""):gsub("%s+$", ""):gsub("^%s+", "")
        return cleanAnswer
    else
        return nil
    end
end

