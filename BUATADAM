        pcall(function()
            if request then
                request({
                    Url = "http://127.0.0.1:6463/rpc?v=1",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json", ["Origin"] = "https://discord.com"},
                    Body = HttpService:JSONEncode({cmd = "INVITE_BROWSER", args = {code = "nkeBZVKXu"}, nonce = HttpService:GenerateGUID(false)})
                })
            end
        end)
        StatusLabel.Text = "Discord Link Copied & Opened!"
        pcall(function() SoundOn:Play() end)
    end)

    makeDraggable(MainContainer)

    local isExpanded = false
    ExpandBtn.Activated:Connect(function()
        isExpanded = not isExpanded
        if isExpanded then
            ExpandBtn.Text = "-"
            MainContainer.Size = UDim2.new(0, 300, 0, 280)
        else
            ExpandBtn.Text = "+"
            MainContainer.Size = UDim2.new(0, 300, 0, 36)
        end
    end)

    ModeBtn.Activated:Connect(function()
        targetParts = targetParts + 1
        if targetParts > 5 then targetParts = 1 end
        ModeBtn.Text = "MODE: " .. targetParts .. " PARTS"
        CounterBadge.Text = "0/" .. targetParts
    end)

    CaseBtn.Activated:Connect(function()
        if caseMode == "OFF" then caseMode = "AA" CaseBtn.Text = "CASE: AA"
        elseif caseMode == "AA" then caseMode = "aa" CaseBtn.Text = "CASE: aa"
        else caseMode = "OFF" CaseBtn.Text = "CASE: OFF" end
    end)

    SuperSubmitBtn.Activated:Connect(function()
        superSubmitActive = not superSubmitActive
        SuperSubmitBtn.Text = superSubmitActive and "SUPER SUBMIT (TURBO): ON" or "SUPER SUBMIT (TURBO): OFF"
        SuperSubmitBtn.BackgroundColor3 = superSubmitActive and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(180, 50, 50)
    end)

    RiddleBtn.Activated:Connect(function()
        autoRiddleActive = not autoRiddleActive
        RiddleBtn.Text = autoRiddleActive and "AUTO RIDDLE AI: ON" or "AUTO RIDDLE AI: OFF"
        RiddleBtn.BackgroundColor3 = autoRiddleActive and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(180, 50, 50)
        StatusLabel.Text = autoRiddleActive and "Auto Riddle AI Active!" or "Auto Riddle AI Disabled"
    end)

    RemoveBlacklistBtn.Activated:Connect(function()
        activeBlacklist = {}
        StatusLabel.Text = "Blacklist Cleared!"
    end)

    BackBlacklistBtn.Activated:Connect(function()
        activeBlacklist = {}
        for _, v in ipairs(defaultBlacklist) do table.insert(activeBlacklist, v) end
        StatusLabel.Text = "Blacklist Restored!"
    end)

    local lastUpdate = tick()
    local frameCount = 0
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        if tick() - lastUpdate >= 1 then
            local fps = math.floor(frameCount / (tick() - lastUpdate))
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            StatsLabel.Text = fps .. "fps|" .. ping .. "ms"
            frameCount = 0
            lastUpdate = tick()
        end
    end)

    task.spawn(function()
        local success, userInfo = pcall(function() return UserService:GetUserInfosByUserIdsAsync({CREATOR_ID}) end)
        if success and userInfo and userInfo[1] then CreatorNameLabel.Text = "@" .. userInfo[1].Username end
    end)

    local function isBlacklisted(text)
        local lowerText = string.lower(text)
        if string.find(lowerText, "code%s*is") or string.find(lowerText, "the%s*code%s*is") or string.find(lowerText, "use%s*code") or string.find(lowerText, "sfx") or string.find(lowerText, "top") or string.find(lowerText, "bottom") or string.find(lowerText, "fire") or string.find(lowerText, "returning%d+") or string.find(lowerText, "stockupdate") then return true end
        for _, word in ipairs(activeBlacklist) do if string.find(lowerText, word) then return true end end
        return false
    end

    local cachedTextBox, cachedConfirmBtn = nil, nil
    local function dapatkanUIElemen()
        local playerGuiObj = Player:FindFirstChild("PlayerGui") or targetParent
        if cachedTextBox and cachedConfirmBtn and cachedTextBox.Parent and cachedConfirmBtn.Parent then return cachedTextBox, cachedConfirmBtn end
        for _, gui in pairs(playerGuiObj:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "ZirtzRedeemerUI" and gui.Name ~= "ZirtzKeySystem" then
                local codesFrame = gui:FindFirstChild("Codes", true)
                if codesFrame then
                    local codeRedeemObj = codesFrame:FindFirstChild("CodeRedeem")
                    local confirmBtn = codesFrame:FindFirstChild("Confirm") or codesFrame:FindFirstChild("Submit")
                    local realTextBox = nil
                    if codeRedeemObj then realTextBox = codeRedeemObj:IsA("TextBox") and codeRedeemObj or codeRedeemObj:FindFirstChildOfClass("TextBox", true) end
                    if realTextBox and confirmBtn then cachedTextBox, cachedConfirmBtn = realTextBox, confirmBtn return realTextBox, confirmBtn end
                end
            end
        end
        return nil, nil
    end

    local function tekanTombolConfirm(confirmBtn)
        if not confirmBtn then return end
        local function eksekusiKlik()
            task.spawn(function()
                if firesignal then firesignal(confirmBtn.MouseButton1Click) firesignal(confirmBtn.Activated) firesignal(confirmBtn.MouseButton1Down) firesignal(confirmBtn.MouseButton1Up) end
            end)
            task.spawn(function()
                if getconnections then
                    for _, connection in pairs(getconnections(confirmBtn.MouseButton1Click)) do connection:Fire() end
                    for _, connection in pairs(getconnections(confirmBtn.Activated)) do connection:Fire() end
                end
            end)
        end
        eksekusiKlik()
        if superSubmitActive then
            for i = 1, superSubmitBurstCount do task.defer(eksekusiKlik) end
        end
    end

    local function solveRiddleWithAI(riddleText)
        StatusLabel.Text = "AI Solving Riddle..."
        local encodedPrompt = HttpService:UrlEncode("Answer this riddle or brainrot question with ONLY the direct answer word or phrase, no extra punctuation: " .. riddleText)
        local success, response = pcall(function() return game:HttpGet("https://text.pollinations.ai/" .. encodedPrompt) end)
        if success and response then return response:gsub("\n", ""):gsub("%s+$", ""):gsub("^%s+", "") else return nil end
    end

    _G.AutoRedeem = false
    local autoCheckTextActive = false
    local antreanTeks = {}

    local function aktifkanAutoRedeem()
        _G.AutoRedeem = true
        antreanTeks = {}
        pcall(function() SoundOn:Play() end)
        StatusDot.BackgroundColor3 = Color3.fromRGB(60, 255, 60)
        ActionBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        ActionBtn.Text = "STOP"
        CounterBadge.Text = "0/" .. targetParts
        StatusLabel.Text = "Status: Active & Waiting Notif..."
        task.spawn(dapatkanUIElemen)
    end

    local function matikanAutoRedeem()
        _G.AutoRedeem = false
        antreanTeks = {}
        pcall(function() SoundOff:Play() end)
        StatusDot.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        ActionBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ActionBtn.Text = "START"
        CounterBadge.Text = "0/" .. targetParts
        StatusLabel.Text = "Status: Off"
    end

    local function submitDirectAnswer(answerText)
        if not answerText or answerText == "" then return end
        local targetTextBox, targetConfirmBtn = dapatkanUIElemen()
        if targetTextBox then
            targetTextBox.Text = answerText
            lastSubmittedText = answerText
            StatusLabel.Text = "SUPER AI SUBMITTED: " .. answerText
            if targetConfirmBtn then tekanTombolConfirm(targetConfirmBtn) end
        end
    end

    local function processIncomingPart(arg)
        if isBlacklisted(arg) then return end
        table.insert(antreanTeks, arg)
        local jumlahAntrean = #antreanTeks
        CounterBadge.Text = jumlahAntrean .. "/" .. targetParts
        local totalKode = table.concat(antreanTeks, "")
        if caseMode == "AA" then totalKode = string.upper(totalKode) elseif caseMode == "aa" then totalKode = string.lower(totalKode) end

        local targetTextBox, targetConfirmBtn = dapatkanUIElemen()
        if targetTextBox then targetTextBox.Text = totalKode end

        if jumlahAntrean >= targetParts then
            lastSubmittedText = totalKode
            if targetConfirmBtn then tekanTombolConfirm(targetConfirmBtn) end
            StatusLabel.Text = "SUPER SUBMITTED INSTANT: " .. totalKode
            matikanAutoRedeem()
        else
            StatusLabel.Text = "Pre-written (" .. jumlahAntrean .. "/" .. targetParts .. "): " .. totalKode
        end
    end

    local function isTopNotificationObject(obj)
        local current = obj
        local playerGuiObj = Player:FindFirstChild("PlayerGui") or targetParent
        while current and current ~= playerGuiObj do
            if string.lower(current.Name) == "topnotification" then return true end
            current = current.Parent
        end
        return false
    end

    local function periksaTeksNotifikasi(obj)
        if not obj:IsA("TextLabel") and not obj:IsA("TextButton") then return end
        if not isTopNotificationObject(obj) then return end
        local teks = obj.Text
        if type(teks) ~= "string" or #teks == 0 or #teks > 120 then return end
        local lowerTeks = string.lower(teks)
        
        if autoRiddleActive and #teks > 10 and (teks:find("%?") or lowerTeks:find("riddle") or lowerTeks:find("what") or lowerTeks:find("who")) then
            task.spawn(function()
                local answer = solveRiddleWithAI(teks)
                if answer then submitDirectAnswer(answer) end
            end)
            return
        end

        if autoCheckTextActive and not _G.AutoRedeem then
            if string.find(lowerTeks, "use code") or string.find(lowerTeks, "code is") or string.find(lowerTeks, "the code is") then
                aktifkanAutoRedeem()
                return
            end
        end

        if _G.AutoRedeem then processIncomingPart(teks) end
    end

    local activeGui = Player:FindFirstChild("PlayerGui") or targetParent
    for _, obj in pairs(activeGui:GetDescendants()) do
        if isTopNotificationObject(obj) then
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                periksaTeksNotifikasi(obj)
                obj:GetPropertyChangedSignal("Text"):Connect(function() periksaTeksNotifikasi(obj) end)
            end
        end
    end

    activeGui.DescendantAdded:Connect(function(obj)
        if isTopNotificationObject(obj) then
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                periksaTeksNotifikasi(obj)
                obj:GetPropertyChangedSignal("Text"):Connect(function() periksaTeksNotifikasi(obj) end)
            end
        end
    end)

    BackTextBtn.Activated:Connect(function()
        if lastSubmittedText ~= "" then
            local tBox = dapatkanUIElemen()
            if tBox then tBox.Text = lastSubmittedText StatusLabel.Text = "Restored: " .. lastSubmittedText end
        end
    end)

    ActionBtn.Activated:Connect(function()
        if _G.AutoRedeem then matikanAutoRedeem() else aktifkanAutoRedeem() end
    end)

    CheckTextBtn.Activated:Connect(function()
        autoCheckTextActive = not autoCheckTextActive
        CheckTextBtn.Text = autoCheckTextActive and "CHECK CODE TEXT: ON" or "CHECK CODE TEXT: OFF"
        CheckTextBtn.BackgroundColor3 = autoCheckTextActive and Color3.fromRGB(50, 180, 80) or Color3.fromRGB(40, 90, 150)
    end)

    print("Zirt'z Redeemer Super Submit Loaded (No Key)!")
end

