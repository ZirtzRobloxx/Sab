end

local function matikanAutoRedeem()
    _G.AutoRedeem = false
    antreanTeks = {}
    pcall(function() SoundOff:Play() end)
    StatusDot.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    ActionBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    ActionBtn.Text = "START"
    CounterBadge.Text = "0/" .. targetParts
    StatusLabel.Text = "Status: Off"
end

local function processIncomingPart(arg)
    if isBlacklisted(arg) then return end
    
    table.insert(antreanTeks, arg)
    local jumlahAntrean = #antreanTeks
    CounterBadge.Text = jumlahAntrean .. "/" .. targetParts
    
    local totalKode = table.concat(antreanTeks, "")
    
    if caseMode == "AA" then
        totalKode = string.upper(totalKode)
    elseif caseMode == "aa" then
        totalKode = string.lower(totalKode)
    end

    local targetTextBox, targetConfirmBtn = dapatkanUIElemen()

    if targetTextBox then 
        targetTextBox.Text = totalKode 
    end

    if jumlahAntrean < targetParts then
        StatusLabel.Text = "Pre-written (" .. jumlahAntrean .. "/" .. targetParts .. "): " .. totalKode
    else
        lastSubmittedText = totalKode
        
        if targetConfirmBtn then 
            tekanTombolConfirm(targetConfirmBtn) 
        end
        
        StatusLabel.Text = "SUBMITTED INSTANT (0.0s): " .. totalKode
        
        _G.AutoRedeem = false
        antreanTeks = {}
        StatusDot.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        ActionBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ActionBtn.Text = "START"
    end
end

