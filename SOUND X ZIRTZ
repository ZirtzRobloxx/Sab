_G.AutoRedeem = false
local autoCheckTextActive = false
local antreanTeks = {}

local function aktifkanAutoRedeem()
    _G.AutoRedeem = true
    antreanTeks = {}
    pcall(function() SoundOn:Play() end)
    StatusDot.BackgroundColor3 = Color3.fromRGB(60, 255, 60)
