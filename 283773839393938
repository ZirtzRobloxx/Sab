-- NO ANIMATION OPTIMIZED
local noAnimActive = false
local animConnections = {}

local function applyNoAnimToCharacter(char)
    if not char or char == Player.Character then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, tr in pairs(hum:GetPlayingAnimationTracks()) do pcall(function() tr:Stop(0) end) end
        local conn = hum.AnimationPlayed:Connect(function(track)
            if noAnimActive then pcall(function() track:Stop(0) end) end
        end)
        table.insert(animConnections, conn)
    end
end

NoAnimBtn.Activated:Connect(function()
    noAnimActive = not noAnimActive
    if noAnimActive then
        NoAnimBtn.Text = "NO ANIMATION: ON"
        NoAnimBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player and p.Character then applyNoAnimToCharacter(p.Character) end
        end
    else
        NoAnimBtn.Text = "NO ANIMATION: OFF"
        NoAnimBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 150)
        for _, conn in pairs(animConnections) do if conn then conn:Disconnect() end end
        animConnections = {}
    end
end)

-- ANTI LAG FITUR
local antiLagActive = false
local originalParticleRates = {}
local descendantConnection = nil

local function applyOptimization(v)
    if v:IsA("ParticleEmitter") then
        if not originalParticleRates[v] then originalParticleRates[v] = v.Rate end
        v.Rate = math.max(0.1, originalParticleRates[v] * 0.005)
    elseif v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") then
        v.Enabled = false
    elseif v:IsA("Decal") or v:IsA("Texture") then
        v.Transparency = 1
    elseif v:IsA("BasePart") then
        v.Material = Enum.Material.Plastic
        v.Reflectance = 0
        v.CastShadow = false
    end
end

AntiLagBtn.Activated:Connect(function()
    antiLagActive = not antiLagActive
    if antiLagActive then
