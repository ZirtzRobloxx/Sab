local function processIncomingPart(arg)
    if isBlacklisted(arg) then return end
    
    table.insert(antreanTeks, arg)
    local jumlahAntrean = #antreanTeks
    CounterBadge.Text = jumlahAntrean .. "/3"
    
    local totalKode = table.concat(antreanTeks, "")
    local targetTextBox, targetConfirmBtn = dapatkanUIElemen()

    if jumlahAntrean < 3 then
        if targetTextBox then targetTextBox.Text = totalKode end
        StatusLabel.Text = "Pre-written (" .. jumlahAntrean .. "/3): " .. totalKode
    else
        -- 0.0 Detik Instant Submit
        lastSubmittedText = totalKode
        if targetTextBox then targetTextBox.Text = totalKode end
        if targetConfirmBtn then tekanTombolConfirm(targetConfirmBtn) end
        StatusLabel.Text = "SUBMITTED INSTANT: " .. totalKode
        
        -- Otomatis mati setelah 1x submit berhasil
        task.wait(0.2)
        matikanAutoRedeem()
    end
end

