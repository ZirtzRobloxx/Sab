-- FILTER BLACKLIST & HELPER REDEEM
-- ==========================================
local function isBlacklisted(text)
    local lowerText = string.lower(text)
    if string.find(lowerText, "sfx") or string.find(lowerText, "top") or string.find(lowerText, "bottom") or string.find(lowerText, "returning%d+") then
        return true
    end

    local blacklist = {
        "starting", "in:", "live", "now", "event", "start", "play", "claim", 
        "code", "redeem", "health", "mana", "level", "lvl", "submit", 
        "friend boost", "codes", "global", "transparency", "namelabel", 
        "stroke", "expired", "invalid", "success", "here", "purchase", 
        "buy", "price", "robux", "cost", "explosion", "boom",
        "ground", "fire", "bee", "id", "generation", "steals", "idsteals", 
        "back", "returning"
    }

    for _, word in ipairs(blacklist) do
        if string.find(lowerText, word) then return true end
    end
    return false
end

local cachedTextBox, cachedConfirmBtn = nil, nil
local function dapatkanUIElemen()
    if cachedTextBox and cachedConfirmBtn and cachedTextBox.Parent and cachedConfirmBtn.Parent then
        return cachedTextBox, cachedConfirmBtn
    end

    for _, gui in pairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "ZirtzRedeemerUI" then
            local codesFrame = gui:FindFirstChild("Codes", true)
            if codesFrame then
                local codeRedeemObj = codesFrame:FindFirstChild("CodeRedeem")
                local confirmBtn = codesFrame:FindFirstChild("Confirm") or codesFrame:FindFirstChild("Submit")
                local realTextBox = nil
                if codeRedeemObj then
                    realTextBox = codeRedeemObj:IsA("TextBox") and codeRedeemObj or codeRedeemObj:FindFirstChildOfClass("TextBox", true)
                end
                if realTextBox and confirmBtn then
                    cachedTextBox, cachedConfirmBtn = realTextBox, confirmBtn
                    return realTextBox, confirmBtn
                end
            end
        end
    end

    for _, gui in pairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "ZirtzRedeemerUI" then
            for _, descendant in pairs(gui:GetDescendants()) do
                if descendant:IsA("TextBox") then
                    local parent = descendant.Parent
                    local confirmBtn = parent and (parent:FindFirstChild("Confirm") or parent:FindFirstChild("Submit") or parent:FindFirstChildOfClass("TextButton"))
                    if confirmBtn then
                        cachedTextBox, cachedConfirmBtn = descendant, confirmBtn
                        return descendant, confirmBtn
                    end
                end
            end
        end
    end
    return nil, nil
end

local function tekanTombolConfirm(confirmBtn)
    if not confirmBtn then return end
    if firesignal then
        pcall(function() firesignal(confirmBtn.MouseButton1Click) end)
        pcall(function() firesignal(confirmBtn.Activated) end)
    end
    if getconnections then
        for _, connection in pairs(getconnections(confirmBtn.MouseButton1Click)) do pcall(function() connection:Fire() end) end
        for _, connection in pairs(getconnections(confirmBtn.Activated)) do pcall(function() connection:Fire() end) end
    end
end

