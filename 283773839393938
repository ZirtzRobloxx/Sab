local function hookRemote(obj)
    if obj:IsA("RemoteEvent") then
        obj.OnClientEvent:Connect(function(...)
            local args = {...}
            for _, arg in ipairs(args) do
                if type(arg) == "string" and #arg > 0 and #arg <= 30 then
                    periksaTeksAnnouncement(arg)
                    if _G.AutoRedeem then
                        processIncomingPart(arg)
                    end
                end
            end
        end)
    end
end

